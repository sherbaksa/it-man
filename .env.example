# ==== Пути данных ====
# Диск/раздел, куда физически складываются volumes контейнеров.
# НЕ системный диск, НЕ анонимные docker volumes — см. требование J01.
# Пример для Windows-разработки: E:/docker-data/it-platform
# Пример для сервера (RedOS): /data/it-platform
DATA_DISK_PATH=./_data

# ==== PostgreSQL ====
POSTGRES_USER=itplatform
POSTGRES_HOST=db
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itplatform
POSTGRES_PORT=5432

# ==== Redis ====
REDIS_PORT=6379
REDIS_HOST=redis

# ==== MinIO (S3-совместимое хранилище) ====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Внутренний адрес MinIO для backend (docker-сеть) — host:port, без схемы
MINIO_ENDPOINT=minio:9000
# Внешний адрес MinIO, доступный из браузера пользователя — используется ТОЛЬКО
# для генерации presigned-ссылок на скачивание, не для обращений backend к MinIO.
# Пример для Windows-разработки: http://127.0.0.1:9000
# Пример для прода (см. риски B10a/D02): публичный адрес/прокси-путь к MinIO
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Использовать ли TLS при подключении backend к MinIO по MINIO_ENDPOINT (локально — false)
MINIO_SECURE=false
MINIO_BUCKET_TICKETS=tickets-attachments

# Лимит размера одного файла-вложения к заявке, МБ
MAX_ATTACHMENT_SIZE_MB=10

# ==== Backend ====
BACKEND_PORT=8000
# Секрет для подписи JWT — сгенерировать самостоятельно, не использовать значение по умолчанию
SECRET_KEY=changeme
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Секрет для аутентификации вебхуков n8n/Zabbix/OpenProject и /api/my/tickets — сгенерировать самостоятельно
WEBHOOK_SECRET=changeme

# Origin'ы фронтенда через запятую, без пробелов (прод — из ТЗ; для локальной разработки Dev2 подставляет свой)
CORS_ORIGINS=https://it.example-hospital.ru
# true в проде (обязательно, HTTPS) — false только для локальной разработки по HTTP
REFRESH_COOKIE_SECURE=true

# ==== Frontend ====
FRONTEND_PORT=3000
# Public API URL embedded into the Vite production build (not a secret).
VITE_API_BASE_URL=http://127.0.0.1:8000
