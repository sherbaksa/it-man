{
  "name": "it-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:types": "openapi-typescript ../docs/api/openapi.json -o src/api/types.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "test:smoke": "node scripts/verify-build.mjs",
    "test:tickets": "node --experimental-strip-types scripts/verify-ticket-attachments.mjs",
    "test:dashboard": "node --experimental-strip-types scripts/verify-executive-summary.mjs",
    "test:orders": "node --experimental-strip-types scripts/verify-orders.mjs",
    "test:monitoring": "node --experimental-strip-types scripts/verify-monitoring.mjs",
    "test:admin": "node --experimental-strip-types scripts/verify-admin.mjs",
    "test:ui": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.1.4",
    "axios": "^1.13.2",
    "docx": "^9.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
